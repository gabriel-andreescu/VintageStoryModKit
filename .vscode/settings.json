{
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[markdown][json][jsonc][yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "*.lua": "lua"
  },
  "stylua.targetReleaseVersion": "v2.5.2",
  "stylua.verify": true,
  "Lua.format.enable": false,
  "xmake.autoGenerateCompileCommands": "disabled",
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/.xmake/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "scratch/**": true
  },
  "search.exclude": {
    "**/.venv/**": true,
    "**/.xmake/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/TestResults/**": true,
    "scratch/**": true
  }
}
