<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <VsmkGamePath Condition="'$(VsmkGamePath)' == ''">$(VINTAGE_STORY)</VsmkGamePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <ProjectReference Include="../VintageStoryModKit.Settings.Core/VintageStoryModKit.Settings.Core.csproj" />
    <ProjectReference Include="../VintageStoryModKit.Settings/VintageStoryModKit.Settings.csproj" />
    <ProjectReference Include="../VintageStoryModKit.Build/VintageStoryModKit.Build.csproj" />
    <Reference
      Include="VintagestoryAPI"
      HintPath="$(VsmkGamePath)/VintagestoryAPI.dll"
      Private="true"
    />
    <Reference
      Include="protobuf-net"
      HintPath="$(VsmkGamePath)/Lib/protobuf-net.dll"
      Private="true"
    />
    <Reference
      Include="Newtonsoft.Json"
      HintPath="$(VsmkGamePath)/Lib/Newtonsoft.Json.dll"
      Private="true"
    />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource
      Include="Fixtures/SettingsHostSchema.json"
      LogicalName="VintageStoryModKit.Settings.Schema"
    />
    <EmbeddedResource
      Include="Fixtures/ClientSettingsHostSchema.json"
      LogicalName="VintageStoryModKit.Settings.ClientSchema"
    />
  </ItemGroup>
</Project>
