name: Build and release

on:
  push:
    branches: [main, dev]
    tags: ["v[0-9]*", "[0-9]*"]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    permissions:
      contents: write
    uses: gabriel-andreescu/VintageStoryModKit/.github/workflows/build.yml@v{{ vsmk_version }}
    with:
      game-version: "{{ game_version }}"
