set_xmakever("3.1.1")
set_project("{{ project_name }}")
set_policy("package.requires_lock", true)

add_repositories("vsmk https://github.com/gabriel-andreescu/VintageStoryModKit.git")
add_repositories("xmake-luals https://github.com/gabriel-andreescu/xmake-luals.git")
add_addons("vsmk {{ vsmk_version }}", "xmake-luals 0.1.0")
includes("@addon/vsmk/project", "@addon/xmake-luals/luals")

target("{{ project_name }}", function()
    add_rules("@addon/vsmk/mod", { project = "src/{{ project_name }}/{{ project_name }}.csproj" })
    add_installfiles("$(projectdir)/modinfo.json")
    add_installfiles("$(projectdir)/(assets/**)")
end)
