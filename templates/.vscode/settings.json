{
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
    "editor.formatOnSave": true
  },
  "[xml]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
    "editor.formatOnSave": true
  },
  "[markdown][json][jsonc][yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "stylua.targetReleaseVersion": "v2.5.2",
  "stylua.verify": true,
  "Lua.format.enable": false,
  "files.associations": {
    "*.lua": "lua"
  },
  "xmake.autoGenerateCompileCommands": "disabled",
  "files.watcherExclude": {
    "**/.xmake/**": true,
    "**/.vsmk/**": true,
    "**/build/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/.xmake/**": true,
    "**/.vsmk/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/TestResults/**": true
  }
}
