{% from 'templates/_partials/json.jinja' import prettier_json %}
{% set settings = {
    '[lua]': {'editor.defaultFormatter': 'JohnnyMorganz.stylua'},
    '[markdown][json][jsonc][yaml]': {'editor.defaultFormatter': 'esbenp.prettier-vscode'},
    'stylua.targetReleaseVersion': 'v2.5.2',
    'stylua.verify': true,
    'Lua.format.enable': false,
    'xmake.autoGenerateCompileCommands': 'disabled',
    'files.watcherExclude': {'**/.xmake/**': true, '**/.vsmk/**': true, '**/build/**': true, '**/dist/**': true},
    'search.exclude': {'**/.xmake/**': true, '**/.vsmk/**': true, '**/build/**': true, '**/dist/**': true, '**/TestResults/**': true}
} %}
{% set _ = settings.update({
    '[csharp]': {'editor.defaultFormatter': 'csharpier.csharpier-vscode', 'editor.formatOnSave': true},
    '[xml]': {'editor.defaultFormatter': 'csharpier.csharpier-vscode', 'editor.formatOnSave': true}
}) %}
{% set _ = settings.update({'files.associations': {'*.lua': 'lua'}}) %}
{{ prettier_json(settings) }}
