exclude: ^(build/|dist/|scratch/|\.xmake/|\.vsmk/)|(^|/)TestResults/

repos:
  - repo: local
    hooks:
      - id: prettier
        name: Prettier
        language: node
        entry: prettier --write
        additional_dependencies: [prettier@3.9.7]
        types: [text]
        files: \.(md|ya?ml|jsonc?)$
      - id: csharpier
        name: CSharpier
        language: system
        entry: dotnet csharpier format
        types: [text]
        files: \.(cs|csx|csproj|props|targets|slnx|xml|config)$
      - id: stylua
        name: StyLua
        language: node
        entry: stylua
        additional_dependencies: ["@johnnymorganz/stylua-bin@2.5.2"]
        types: [lua]
        args: [--verify]
